{
  "name": "dsh-ltm-gate",
  "version": "0.2.0",
  "private": true,
  "description": "Hard LTM recall gate for DeepSeek Harness: blocks non-LTM tool calls until a memory recall succeeds in the session.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node _smoke.mjs && node _schema.test.mjs && node _client.test.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
